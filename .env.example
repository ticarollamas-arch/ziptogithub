# ==============================================================================
# ZipToGit & Reverse Engineering Architect - Environment Variables
# ==============================================================================

# NVIDIA NIM Free Tier (build.nvidia.com) - Meta Llama 3.3, Mistral, DeepSeek
NVIDIA_API_KEY=sua_chave_aqui

# OpenAI API Key (platform.openai.com) - GPT-4o, GPT-4o-mini, o3-mini
OPENAI_API_KEY=

# DeepSeek API Key (platform.deepseek.com) - deepseek-chat (V3), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=

# Groq Cloud API Key (console.groq.com) - Meta Llama 3.3 70B ultra-fast inference
GROQ_API_KEY=

# Local Ollama Endpoint (ollama.com) - 100% offline & free, no API key required
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional Gemini API Key
GEMINI_API_KEY=

# Port for HTTP server (defaults to 3000)
PORT=3000

# Permite URLs de IA locais/privadas (Ollama). Padrão: só fora da Vercel/produção.
# ALLOW_LOCAL_AI=true

# --- Kit comercial ---
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KIT_NAMESPACE=ziptogit
KIWIFY_TOKEN=
HOTMART_HOTTOK=
SUPPORT_EMAIL=
